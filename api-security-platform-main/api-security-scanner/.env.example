# Flask Web Dashboard Settings
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Connection
DATABASE_URL=sqlite:///database/scanner.db

# Scanner Engine Thresholds
MAX_ENDPOINTS=50
SCAN_TIMEOUT=30

# Logging Output Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Database backend: sqlite (default) or firestore
# - sqlite: local file, wiped on Render redeploys (fine for dev)
# - firestore: Google Cloud Firestore (NoSQL) — needs the Firebase vars below
#   and a Firestore database created in the Firebase console.
#   No GOOGLE_APPLICATION_CREDENTIALS file needed: the app authenticates with
#   FIREBASE_SERVICE_ACCOUNT_JSON (same login as Firebase Auth).
DB_BACKEND=sqlite

# Firebase Web config (public values, safe to share)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK (SECRET — service account JSON, one line).
# Already required for login; Firestore uses this same credential.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# AI assistant (optional): free key from https://aistudio.google.com
GOOGLE_AI_API_KEY=
# OPENAI_API_KEY=

# Email for one-time passcodes (optional): free SendGrid key
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
